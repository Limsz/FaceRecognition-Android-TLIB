<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Blue Header Background -->
    <!-- Blue Header Background -->

    <!-- Title Text in Header -->
    <View
        android:id="@+id/header"
        android:layout_width="424dp"
        android:layout_height="173dp"
        android:background="#4293D3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Optional: Gear Icon for Settings -->

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/alata"
        android:gravity="center"
        android:text="Face Recognition"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/header"
        app:layout_constraintVertical_bias="0.123" />

    <ImageButton
        android:id="@+id/buttonSetting"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="Settings"
        android:src="@drawable/ic_settings"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="#4293D3"
        android:layout_margin="16dp"
        android:tint="@android:color/white" />

    <!-- Overlapping White Rounded Content Panel -->
    <LinearLayout
        android:id="@+id/whitePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="70dp"
        android:background="@drawable/rounded_top_white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:translationY="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/header"
        app:layout_constraintVertical_bias="1.0">

        <!-- Rectangular Photo -->
        <ImageView
            android:id="@+id/imageTitle"
            android:layout_width="335dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/tech1" />

        <!-- Camera Preview -->

        <!-- FrameLayout with rounded corners to contain CameraView -->


        <TextView
            android:id="@+id/textViewIdentifiedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/alata"
            android:gravity="center"
            android:text="Identity: Unknown"
            android:textColor="#1C1B1F"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/textTimestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/alata"
            android:gravity="center"
            android:textColor="#1C1B1F"
            android:textSize="16sp"
            android:text="0000-00-00 00:00:00 AM/PM" />

        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_camera_preview">

            <io.fotoapparat.view.CameraView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.kbyai.facerecognition.FaceView
                    android:id="@+id/faceView"
                    android:layout_width="280dp"
                    android:layout_height="282dp"
                    android:layout_gravity="center"
                    android:translationZ="1dp" />
            </io.fotoapparat.view.CameraView>
        </FrameLayout>

        <!-- SDK Info Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="8dp" />

        <!-- Button Row 1 -->
        <LinearLayout
            android:id="@+id/lytButtons1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/buttonEnroll"
                    android:layout_width="51dp"
                    android:layout_height="46dp"
                    android:layout_margin="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@android:color/white"
                    android:scaleType="fitCenter"
                    android:src="@drawable/upload1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/alata"
                    android:text="Upload Photo"
                    android:textAlignment="center"
                    android:textColor="#0061AE"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/buttonCapture"
                    android:layout_width="104dp"
                    android:layout_height="47dp"
                    android:layout_margin="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@android:color/white"
                    android:scaleType="fitCenter"
                    android:src="@drawable/camera3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/alata"
                    android:text="Capture"
                    android:textAlignment="center"
                    android:textColor="#0061AE"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/buttonAbout"
                    android:layout_width="48dp"
                    android:layout_height="47dp"
                    android:layout_margin="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@android:color/white"
                    android:scaleType="fitCenter"
                    android:src="@drawable/list3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/alata"
                    android:text="Registered"
                    android:textAlignment="center"
                    android:textColor="#0061AE"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Brand Image -->
        <ImageView
            android:id="@+id/imageBrand"
            android:layout_width="136dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            app:srcCompat="@drawable/logo2_png" />

        <!-- People List -->
        <ListView
            android:id="@+id/listPerson"
            android:layout_width="16dp"
            android:layout_height="22dp"
            android:layout_marginTop="16dp"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <!-- Warning Banner -->
        <TextView
            android:id="@+id/textWarning"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/md_theme_light_error"
            android:gravity="center"
            android:text=""
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Brand Footer -->
        <LinearLayout
            android:id="@+id/lytBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
